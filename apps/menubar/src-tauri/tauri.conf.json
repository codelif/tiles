{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tiles",
  "version": "0.1.0",
  "identifier": "social.tiles.menubar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "panel",
        "url": "index.html",
        "width": 380,
        "height": 170,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "visible": false,
        "shadow": true,
        "focus": false,
        "acceptFirstMouse": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
